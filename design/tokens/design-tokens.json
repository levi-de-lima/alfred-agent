{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Alfred (TMB Churn Analyzer) — design tokens. Estes valores são a fonte da verdade. Toda regra de CSS/HTML deve consumir destes nomes.",
  "brand": {
    "name": { "value": "Alfred" },
    "owner": { "value": "TMB" },
    "primaryColor": { "value": "{color.brand.tmbBlue}" }
  },
  "color": {
    "brand": {
      "tmbBlue":       { "value": "#0066FF", "description": "Cor principal. Botões, links, lockup do logo, estados ativos." },
      "tmbBlueHover":  { "value": "#0052CC", "description": "Hover de botões primários (10% mais escuro)." },
      "tmbBluePressed":{ "value": "#0041A3", "description": "Estado :active / pressed (20% mais escuro)." },
      "tmbBlueLight":  { "value": "#E8F0FF", "description": "Fundo de badges, hover suave, tint de elementos." },
      "tmbBlack":      { "value": "#0A0A0A", "description": "Preto institucional TMB. Reservar para co-branding." }
    },
    "semantic": {
      "success": { "value": "#22C55E", "description": "Taxa abaixo da meta, indicadores positivos, check icons." },
      "warning": { "value": "#F59E0B", "description": "Taxa próxima da meta, alertas, cache desatualizado." },
      "danger":  { "value": "#EF4444", "description": "Taxa acima da meta, erros, churn alto." },
      "info":    { "value": "{color.brand.tmbBlue}", "description": "Mensagens informativas neutras." }
    },
    "light": {
      "background":     { "value": "#F7F7F5", "description": "Fundo da página (off-white)." },
      "surface":        { "value": "#FFFFFF", "description": "Fundo do chat, cards, input, header." },
      "surfaceAlt":     { "value": "#FAFAFA", "description": "Linhas alternadas em tabelas, hover de cards." },
      "border":         { "value": "#D4D4D2", "description": "Bordas suaves, divisores." },
      "borderStrong":   { "value": "#C0C0BE", "description": "Borda em foco, bordas de input ativo." },
      "textPrimary":    { "value": "#1A1A1A", "description": "Texto principal." },
      "textSecondary":  { "value": "#6B6B6B", "description": "Texto de suporte, timestamps." },
      "textMuted":      { "value": "#7A7A7A", "description": "Placeholders, rodapés." },
      "userBubble":     { "value": "{color.brand.tmbBlue}", "description": "Fundo da bolha do usuário." },
      "userBubbleText": { "value": "#FFFFFF", "description": "Texto na bolha do usuário." },
      "assistantBubble":{ "value": "#FFFFFF", "description": "Fundo da bolha do Alfred." },
      "assistantBubbleText": { "value": "#1A1A1A", "description": "Texto na bolha do Alfred." },
      "codeBackground": { "value": "#F4F4F2", "description": "Fundo de blocos de código inline e em bloco." }
    },
    "dark": {
      "$description": "Charcoal Notion-style. Background charcoal #1A1A1A, surface levemente mais clara para hierarquia. Azul é deslocado para um tom ligeiramente mais claro (acessibilidade WCAG AA em fundo escuro).",
      "background":     { "value": "#1A1A1A", "description": "Fundo da página." },
      "surface":        { "value": "#242424", "description": "Fundo do chat, cards, input, header (1 nível acima do background)." },
      "surfaceAlt":     { "value": "#2E2E2E", "description": "Hover, linhas alternadas, código." },
      "border":         { "value": "#3A3A3A", "description": "Bordas e divisores." },
      "borderStrong":   { "value": "#4A4A4A", "description": "Borda em foco, input ativo." },
      "textPrimary":    { "value": "#ECECEC", "description": "Texto principal." },
      "textSecondary":  { "value": "#A0A0A0", "description": "Texto de suporte." },
      "textMuted":      { "value": "#6B6B6B", "description": "Placeholders." },
      "brandAccent":    { "value": "#4D8FFF", "description": "TMB Blue ajustado para fundo escuro — contraste AA com #1A1A1A." },
      "brandAccentLight":{ "value": "#1A2E5C", "description": "Equivalente ao TMB Blue Light em dark — fundo de badges/hover." },
      "userBubble":     { "value": "#4D8FFF", "description": "Bolha do usuário usa o azul ajustado." },
      "userBubbleText": { "value": "#0A0F1F", "description": "Texto bem escuro sobre azul claro para contraste alto." },
      "assistantBubble":{ "value": "#242424", "description": "Bolha do Alfred igual ao surface." },
      "assistantBubbleText": { "value": "#ECECEC" },
      "codeBackground": { "value": "#0F0F0F", "description": "Bloco de código mais escuro para destacar do surface." }
    }
  },
  "typography": {
    "fontFamily": {
      "sans":     { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "description": "Fonte da UI — header, mensagens, tabelas, botões. Todo o produto." },
      "wordmark": { "value": "'Cinzel', serif", "description": "Wordmark do logo apenas — 'ALFRED' em caixa alta. Não usar em outro lugar." },
      "mono":     { "value": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace", "description": "Trechos de código nas respostas do Alfred." }
    },
    "fontWeight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    },
    "fontSize": {
      "xs":   { "value": "12px", "description": "Timestamps, badges, footer." },
      "sm":   { "value": "13px", "description": "Texto em tabelas, metadados." },
      "base": { "value": "15px", "description": "Texto padrão das mensagens." },
      "md":   { "value": "16px", "description": "Texto de input." },
      "lg":   { "value": "18px", "description": "Nome do app no header." },
      "xl":   { "value": "20px" },
      "2xl":  { "value": "24px" },
      "3xl":  { "value": "32px" }
    },
    "lineHeight": {
      "tight":  { "value": 1.2 },
      "normal": { "value": 1.5 },
      "relaxed":{ "value": 1.6, "description": "Padrão para mensagens do chat." }
    },
    "letterSpacing": {
      "tight":  { "value": "-0.02em", "description": "Wordmark 'alfred'." },
      "normal": { "value": "0" },
      "wide":   { "value": "0.05em", "description": "Caps em labels." }
    }
  },
  "spacing": {
    "0":  { "value": "0" },
    "1":  { "value": "4px" },
    "2":  { "value": "8px" },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "20px" },
    "6":  { "value": "24px" },
    "8":  { "value": "32px" },
    "10": { "value": "40px" },
    "12": { "value": "48px" },
    "16": { "value": "64px" }
  },
  "radius": {
    "sm":     { "value": "6px",  "description": "Badges, pills pequenos." },
    "md":     { "value": "8px",  "description": "Container de tabelas, cards pequenos." },
    "lg":     { "value": "12px", "description": "Cards, input bar." },
    "xl":     { "value": "18px", "description": "Bolhas do chat (cantos arredondados)." },
    "xlTight":{ "value": "4px",  "description": "Canto 'pinch' das bolhas (o que aponta para o emissor)." },
    "full":   { "value": "9999px", "description": "Botão de enviar (círculo)." }
  },
  "shadow": {
    "$description": "Sombras devem ser sutis. Não usar drop-shadow pesada — vai contra o tom Notion-like definido no DESIGN.md.",
    "none":   { "value": "none" },
    "subtle": { "value": "0 1px 2px rgba(10, 10, 10, 0.10)" },
    "card":   { "value": "0 1px 3px rgba(10, 10, 10, 0.12), 0 1px 2px rgba(10, 10, 10, 0.10)" }
  },
  "layout": {
    "chatMaxWidth":    { "value": "780px" },
    "headerHeight":    { "value": "56px" },
    "inputBarHeight":  { "value": "72px" },
    "messageGap":      { "value": "16px" },
    "userBubbleMaxWidth":      { "value": "75%" },
    "assistantBubbleMaxWidth": { "value": "85%" },
    "responsiveBreakpoint":    { "value": "600px" }
  },
  "motion": {
    "$description": "Animações restritas conforme DESIGN.md — apenas loading dos três pontos.",
    "duration": {
      "fast":   { "value": "120ms" },
      "normal": { "value": "200ms" },
      "slow":   { "value": "400ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" }
    }
  },
  "zIndex": {
    "base":     { "value": 0 },
    "header":   { "value": 10 },
    "inputBar": { "value": 10 },
    "toast":    { "value": 50 },
    "modal":    { "value": 100 }
  }
}
