# Google Gemini (obter em https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIzaSy...

# SharePoint — URL completa do arquivo Excel
EXCEL_FILE_PATH=https://suaempresa.sharepoint.com/Documentos%20Compartilhados/pasta/arquivo.xlsx

# Arquivo local — alternativa ao SharePoint quando há MFA (OneDrive sincronizado ou download manual)
# Se definido, tem prioridade sobre a conexão SharePoint.
# Exemplo Windows (OneDrive): C:/Users/SeuUsuario/TMB Educação/Documentos Compartilhados/Comercial/5 - Rev Ops/02 - Análise de Churn/agente-churn.xlsx
EXCEL_LOCAL_PATH=

# Credenciais SharePoint (conta de serviço sem MFA — deixe em branco se usar EXCEL_LOCAL_PATH)
SHAREPOINT_USERNAME=conta@empresa.com
SHAREPOINT_PASSWORD=senha

# Gemini (opcional — padrão: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Cache
CACHE_DIR=./cache
CACHE_MAX_AGE_HOURS=4

# Logs
LOG_DIR=./logs
LOG_LEVEL=INFO
